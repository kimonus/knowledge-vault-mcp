# syntax=docker/dockerfile:1.11
FROM golang:1.26.10-bookworm@sha256:632dff7351799a5a9954a48dc06670ade72ee44e8c351cdc0e5a57af2fea21af AS restic-builder
ARG RESTIC_COMMIT=6aa3a516ce654808a1f28f9fa21e9b7c8e6e90bf
WORKDIR /src
# All upgraded modules below are explicitly version-pinned.
# hadolint ignore=DL3062
RUN git clone --filter=blob:none https://github.com/restic/restic.git . \
    && git checkout --detach "${RESTIC_COMMIT}" \
    && go get golang.org/x/crypto@v0.57.0 golang.org/x/net@v0.60.0 \
      golang.org/x/text@v0.42.0 google.golang.org/grpc@v1.83.2 \
      github.com/klauspost/compress@v1.18.7 \
    && go mod tidy \
    && go run build.go \
    && ./restic version

FROM postgres:17-bookworm@sha256:858bb5e98eed02eb8cafbcdc007f9a65d1b613972028944a8ec2133ccaf80d27 AS postgres-runtime
# Keep the OpenSSL fix until the pinned base contains it; gosu is unused by this image.
RUN apt-get update \
    && apt-get install --yes --no-install-recommends --only-upgrade \
      libssl3=3.0.22-1~deb12u2 openssl=3.0.22-1~deb12u2 \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /usr/local/bin/gosu /etc/ssl/private/ssl-cert-snakeoil.key

FROM scratch
LABEL org.opencontainers.image.title="Knowledge Vault backup" \
      org.opencontainers.image.description="Pinned pg_dump and restic backup helper" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.version="0.6.0"
ENV PATH="/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin"
# Flatten the sanitized stage so deleted upstream test keys and gosu are absent from every layer.
# hadolint ignore=DL3067
COPY --from=postgres-runtime / /
COPY --from=restic-builder /src/restic /usr/local/bin/restic
COPY --chown=999:999 scripts/backup.sh /usr/local/bin/knowledge-vault-backup
USER 999:999
ENTRYPOINT ["/usr/local/bin/knowledge-vault-backup"]
