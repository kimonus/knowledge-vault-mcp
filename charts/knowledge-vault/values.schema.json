{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image",
    "config",
    "auth",
    "database",
    "internalPostgresql"
  ],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "const": 1
    },
    "image": {
      "$ref": "#/$defs/image"
    },
    "backupImage": {
      "$ref": "#/$defs/image"
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "publicBaseUrl",
        "authIssuerUrl",
        "ingestionPolicyVersion",
        "embeddingsEnabled",
        "embeddingModel",
        "embeddingDimensions",
        "logLevel",
        "corsOrigins",
        "maxRequestBytes",
        "maxBatchItems",
        "maxPartItems"
      ],
      "properties": {
        "environment": {
          "enum": [
            "production",
            "development",
            "test"
          ]
        },
        "publicBaseUrl": {
          "type": "string"
        },
        "authIssuerUrl": {
          "type": "string"
        },
        "ingestionPolicyVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "ingestionPolicy": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 8192,
          "pattern": "\\S"
        },
        "embeddingsEnabled": {
          "type": "boolean"
        },
        "embeddingModel": {
          "type": "string",
          "minLength": 1
        },
        "embeddingDimensions": {
          "type": "integer",
          "minimum": 8,
          "maximum": 4096
        },
        "logLevel": {
          "enum": [
            "DEBUG",
            "INFO",
            "WARNING",
            "ERROR",
            "CRITICAL"
          ]
        },
        "corsOrigins": {
          "type": "string"
        },
        "maxRequestBytes": {
          "type": "integer",
          "minimum": 1024
        },
        "maxBatchItems": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "maxPartItems": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      }
    },
    "auth": {
      "$ref": "#/$defs/secretRef"
    },
    "cloudflareAccess": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "existingSecret",
        "issuerUrlKey",
        "audienceKey",
        "allowedEmailsKey",
        "scopes",
        "publicHosts",
        "privateHosts"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingSecret": {
          "type": "string"
        },
        "issuerUrlKey": {
          "type": "string",
          "minLength": 1
        },
        "audienceKey": {
          "type": "string",
          "minLength": 1
        },
        "allowedEmailsKey": {
          "type": "string",
          "minLength": 1
        },
        "scopes": {
          "type": "string",
          "minLength": 1
        },
        "publicHosts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "privateHosts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "database": {
      "$ref": "#/$defs/databaseRef"
    },
    "modelCache": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingClaim": {
          "type": "string"
        }
      },
      "required": [
        "existingClaim"
      ]
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api",
        "worker",
        "migration",
        "init"
      ],
      "properties": {
        "api": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "object"
            },
            "limits": {
              "type": "object"
            }
          }
        },
        "worker": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "object"
            },
            "limits": {
              "type": "object"
            }
          }
        },
        "migration": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "object"
            },
            "limits": {
              "type": "object"
            }
          }
        },
        "init": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "object"
            },
            "limits": {
              "type": "object"
            }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "port"
      ],
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "tlsSecret": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^/"
          }
        }
      }
    },
    "internalPostgresql": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": "string"
            }
          }
        },
        "existingSecret": {
          "type": "string"
        },
        "usernameKey": {
          "type": "string"
        },
        "passwordKey": {
          "type": "string"
        },
        "databaseKey": {
          "type": "string"
        },
        "storageClass": {
          "type": "string"
        },
        "storage": {
          "type": "string"
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "object"
            },
            "limits": {
              "type": "object"
            }
          }
        }
      }
    },
    "cloudflareTunnel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "replicaCount",
        "image",
        "existingSecret",
        "tokenKey",
        "logLevel",
        "metricsPort",
        "resources"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "existingSecret": {
          "type": "string"
        },
        "tokenKey": {
          "type": "string",
          "minLength": 1
        },
        "logLevel": {
          "enum": [
            "debug",
            "info",
            "warn",
            "error",
            "fatal"
          ]
        },
        "metricsPort": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "schedule": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "databaseUrlKey": {
          "type": "string"
        },
        "repositoryKey": {
          "type": "string"
        },
        "passwordKey": {
          "type": "string"
        },
        "keepDaily": {
          "type": "integer",
          "minimum": 0
        },
        "keepWeekly": {
          "type": "integer",
          "minimum": 0
        },
        "keepMonthly": {
          "type": "integer",
          "minimum": 0
        },
        "checkSubset": {
          "type": "string"
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "object"
            },
            "limits": {
              "type": "object"
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "apiIngressFrom": {
          "type": "array"
        },
        "metricsIngressFrom": {
          "type": "array"
        },
        "additionalEgress": {
          "type": "array"
        },
        "backupEgress": {
          "type": "array"
        }
      }
    },
    "podAnnotations": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metricsPort"
      ],
      "properties": {
        "metricsPort": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        }
      }
    }
  },
  "$defs": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag",
        "digest",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "secretRef": {
      "type": "object",
      "required": [
        "existingSecret"
      ],
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "tokenPepperKey": {
          "type": "string"
        },
        "bootstrapTokensKey": {
          "type": "string"
        }
      }
    },
    "databaseRef": {
      "type": "object",
      "required": [
        "existingSecret",
        "urlKey"
      ],
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "urlKey": {
          "type": "string"
        }
      }
    }
  }
}
