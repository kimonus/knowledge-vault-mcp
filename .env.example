KNOWLEDGE_VAULT_ENVIRONMENT=development
KNOWLEDGE_VAULT_DATABASE_URL=postgresql://knowledge_vault:CHANGE_ME@127.0.0.1:5432/knowledge_vault
KNOWLEDGE_VAULT_TOKEN_PEPPER=GENERATE_A_RANDOM_VALUE
KNOWLEDGE_VAULT_BOOTSTRAP_TOKENS=[{"principal_id":"me","sha256":"HMAC_SHA256_HEX","scopes":["knowledge:read","knowledge:write","knowledge:admin"]}]
KNOWLEDGE_VAULT_PUBLIC_BASE_URL=https://HOSTNAME_YOU_CONTROL
KNOWLEDGE_VAULT_AUTH_ISSUER_URL=https://AUTH_ISSUER_OR_RESOURCE_OWNER
KNOWLEDGE_VAULT_CLOUDFLARE_ACCESS_ENABLED=false
KNOWLEDGE_VAULT_CLOUDFLARE_ACCESS_ISSUER_URL=https://TEAM.cloudflareaccess.com
KNOWLEDGE_VAULT_CLOUDFLARE_ACCESS_AUDIENCE=APPLICATION_AUD_TAG
KNOWLEDGE_VAULT_CLOUDFLARE_ACCESS_ALLOWED_EMAILS=owner@example.com
KNOWLEDGE_VAULT_CLOUDFLARE_ACCESS_SCOPES=knowledge:read,knowledge:write
KNOWLEDGE_VAULT_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
KNOWLEDGE_VAULT_EMBEDDING_DIMENSIONS=384
KNOWLEDGE_VAULT_EMBEDDINGS_ENABLED=true
